      "includeFiles": "templates/las-cascadas-de-pedregal-condos-for-sale.html"
    },
    "api/**/*.ts": {
      "maxDuration": 30
    },
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT"
        },
        {
          "key": "Access-Control-Expose-Headers",
          "value": "Date, Age"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/new-client",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/new-client-form",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/new-client/:agentSlug",
      "destination": "/contact?agent=:agentSlug",
      "permanent": true
    },
    {
      "source": "/agents/:agentSlug/new-client",
      "destination": "/contact?agent=:agentSlug",
      "permanent": true
    },
    {
      "source": "/susu",
      "destination": "/team",
      "permanent": true
    },
    {
      "source": "/agents/susu",
      "destination": "/team",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/search",
      "destination": "/property-search.html",
      "permanent": true
    },
    {
      "source": "/erika-aispuro",
      "destination": "/erika",
      "permanent": true
    },
    {
      "source": "/fernando",
      "destination": "/fernando-cabrera",
      "permanent": true
    },
    {
      "source": "/idx-search",
      "destination": "/property-search.html",
      "permanent": true
    },
    {
      "source": "/properties/map",
      "destination": "/property-search.html",
      "permanent": true
    },
    {
      "source": "/market-report",
      "destination": "/los-cabos-real-estate-market.html",
      "permanent": true
    }
  ]
}
